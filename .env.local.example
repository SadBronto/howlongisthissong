# Supabase — find these in your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# For the MusicBrainz import script
# MBDUMP_PATH=/path/to/extracted/mbdump

# Spotify enrichment (optional, Phase 2)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Resend (optional, for future email features)
# RESEND_API_KEY=
