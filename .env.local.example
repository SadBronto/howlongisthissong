# ── Supabase (Phase 1 / fallback) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# ── Cloudflare D1 (Phase 2 — replaces Supabase) ───────────────────────────────
# Worker URL — set this in Netlify env vars after deploying the Worker
# NEXT_PUBLIC_WORKER_URL=https://howlongisthissong-search.your-subdomain.workers.dev

# Used by scripts/import-d1.ts
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_D1_DATABASE_ID=

# ── MusicBrainz import ────────────────────────────────────────────────────────
# MBDUMP_PATH=./mbdump

# ── Future enrichment ─────────────────────────────────────────────────────────
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# RESEND_API_KEY=
